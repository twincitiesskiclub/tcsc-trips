---
/** One row inside Ledger. The parent selects the column grammar and colors. */
interface Props {
  label?: string;
  title?: string;
  meta?: string;
  note?: string;
  href?: string;
  header?: boolean;
  class?: string;
}

const { label, title, meta, note, href, header = false, class: className } = Astro.props;
const Row = href ? 'a' : 'div';
const hasNoteSlot = Astro.slots.has('note');
const linkTarget = title ? 'title' : 'label';
---

<Row
  {...(href ? { href } : {})}
  class:list={['ledger-row', href && 'link-ledger', header && 'ledger-row-header', className]}
  data-ledger-row
  data-has-label={String(Boolean(label))}
  data-link-target={href ? linkTarget : undefined}
>
  {label && <div class="ledger-label">{label}</div>}
  {(title || note || hasNoteSlot) && (
    <div class="ledger-detail">
      {title && <div class="ledger-title">{title}</div>}
      {note && <p class="ledger-note">{note}</p>}
      {hasNoteSlot && <div class="ledger-note"><slot name="note" /></div>}
    </div>
  )}
  {meta && <div class="ledger-meta">{meta}</div>}
</Row>
