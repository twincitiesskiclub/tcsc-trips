---
// CoachEntry: asymmetric editorial split (NOT a card, per the design
// system). Photo holds its native square in four site-grid columns; name and
// bio take the seven-column reading slot. Bio body comes through the slot
// (render(entry) Content at the call site).
//
// WHY CONSTRAINED, NOT FULL-BLEED: coach source photos are modest quality
// (KJ's is visibly soft at full size). Keeping the source at or above 1x in
// a four-column square makes that softness recede without inventing a crop.
//
// CROP STRATEGY: the square slot is emitted server-side and
// position="attention" uses sharp's saliency crop, which chases faces instead
// of the geometric center. `object_position` remains as a CSS fallback for
// rounding slack, biased ~30% from top where heads live.
import { Image } from 'astro:assets';
import { CARD } from '@/components/imageWidths';

interface Props {
  name: string;
  role: string;
  photo: ImageMetadata;
  photoAlt: string;
  credentials?: string[];
  /** Anchor id for deep links (scroll-margin handled here). */
  anchor?: string;
  /** CSS object-position fallback for the residual in-browser crop. */
  object_position?: string;
  /**
   * 'eager' for the first (above-the-fold) entry only: its photo is the
   * page's LCP element, and lazy-loading it failed Lighthouse's
   * lcp-lazy-loaded audit. Entries below the fold stay lazy.
   */
  loading?: 'eager' | 'lazy';
  rhythm?: 'sm' | 'md' | 'lg';
}
const {
  name,
  role,
  photo,
  photoAlt,
  credentials = [],
  anchor,
  object_position = 'center 30%',
  loading = 'lazy',
  rhythm = 'sm',
} = Astro.props;
const rhythmClass = { sm: 'band-y-sm', md: 'band-y', lg: 'band-y-lg' }[rhythm];

const cropSize = Math.min(1200, photo.width, photo.height);
---
<article id={anchor} class="border-b hairline-soft last:border-b-0 scroll-mt-24">
  {/* All photos sit left: a steady column instead of an alternator
      performing fake variety. */}
  <div class:list={['gutter mx-auto max-w-site grid grid-cols-1 gap-x-4 gap-y-6 min-[30rem]:grid-cols-[15rem_minmax(0,1fr)] md:grid-cols-12 md:gap-x-14 md:gap-y-0 items-start', rhythmClass]}>
    <div class="relative aspect-square w-full max-w-60 overflow-hidden md:col-span-4 md:max-w-none">
      <Image
        src={photo}
        alt={photoAlt}
        widths={CARD}
        width={cropSize}
        height={cropSize}
        fit="cover"
        position="attention"
        sizes="(min-width: 768px) 33vw, 240px"
        class="absolute inset-0 w-full h-full object-cover"
        style={`object-position: ${object_position}`}
        loading={loading}
        fetchpriority={loading === 'eager' ? 'high' : 'auto'}
        decoding="async"
      />
    </div>
    <div class="contents md:block md:col-start-6 md:col-span-7 md:self-start">
      <header class="min-w-0 min-[30rem]:col-start-2 min-[30rem]:row-start-1 self-start md:block">
        {/* Plain sentence-case role: uppercase tracked labels repeated four
            times down the page read as scaffolding, not information. */}
        <h2 class="coach-name type-h2 text-navy">{name}</h2>
        <p class="mt-2 text-mint-deep font-semibold">{role}</p>
      </header>
      <div class="min-[30rem]:col-span-2 min-[30rem]:col-start-1 md:block">
        <div class="md:mt-6 prose max-w-prose text-ink">
          <slot />
        </div>
        {credentials.length > 0 && (
          <ul class="mt-6 text-sm text-slate space-y-1">
            {credentials.map((c) => (
              <li class="before:content-['·'] before:mr-2">{c}</li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</article>

