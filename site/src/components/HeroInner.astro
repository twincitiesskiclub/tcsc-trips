---
// Ruled two-cell ledger masthead: H1 in the wide column, page-specific
// STATIC org facts bottom-baselined in the narrow column as a stat stack
// (value over small-caps label, behind a vertical hairline; build-time
// strings only; live data belongs exclusively to the conditions strip).
// With no facts the band collapses to a single column, no hole.
// Optional `photo` renders a full-bleed photo band directly under the
// masthead grid (About: team photo, Community: canoe social, Racing: race
// crew) - the answer to "the pages feel blank" without inventing a new
// hero shape per page.
import { Image } from 'astro:assets';
import { FULL_BLEED } from '@/components/imageWidths';
import type { Fact } from '@/components/heroFacts';
import FactStack from '@/components/FactStack.astro';

interface Props {
  headline: string;
  subhead?: string;
  facts?: Fact[];
  photo?: ImageMetadata;
  /** Required in practice for content photos; omit only for a genuinely decorative band. */
  photoAlt?: string;
  /** CSS object-position for the band crop, e.g. "center 40%". */
  photoPosition?: string;
  rhythm?: 'sm' | 'md' | 'lg';
}
const { headline, subhead, facts = [], photo, photoAlt, photoPosition, rhythm = 'sm' } = Astro.props;
const rhythmClass = { sm: 'band-y-sm', md: 'band-y', lg: 'band-y-lg' }[rhythm];
---
<section class="bg-paper text-ink border-y hairline">
  <div class:list={['gutter mx-auto max-w-site grid gap-x-10 gap-y-6 md:grid-cols-12', rhythmClass]}>
    <div class:list={[facts.length > 0 ? 'md:col-span-7' : 'md:col-span-9']}>
      <h1 class="type-display-inner text-navy">{headline}</h1>
      {subhead && <p class="type-lede mt-4 text-slate max-w-prose">{subhead}</p>}
    </div>
    {facts.length > 0 && (
      <FactStack
        facts={facts}
        size="md"
        align="end"
        class="md:col-span-3 md:col-start-10"
      />
    )}
  </div>
  {photo && (
    <Image
      src={photo}
      alt={photoAlt ?? ''}
      widths={FULL_BLEED}
      sizes="100vw"
      class="aspect-[16/5] min-h-band-photo-min max-h-band-photo-max w-full object-cover"
      style={photoPosition ? `object-position: ${photoPosition}` : undefined}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}
</section>
