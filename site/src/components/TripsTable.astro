---
// TripsTable: a ledger, not a data grid. A labeled column-header row over
// ruled rows (dates / trip / where) gives one or two trips the dignity of a
// schedule instead of an orphaned row; the empty state is a ruled placeholder
// row in the same grammar (static copy, can't flicker). Rows link straight to
// the trip's tcsc.ski registration page (signup_url); there are no local trip
// detail pages. entry.data.slug is the DISPLAY NAME (see content.config.ts).
import { getCollection } from 'astro:content';
import Ledger from '@/components/Ledger.astro';
import LedgerRow from '@/components/LedgerRow.astro';

const trips = await getCollection('trips');
trips.sort((a, b) => a.data.order - b.data.order || a.data.dates.localeCompare(b.data.dates));
---
<Ledger cols="three" rule="top" surface="paper">
  <LedgerRow label="Dates" title="Trip" meta="Where" header />
  {trips.length === 0 ? (
    <LedgerRow title="No trips posted yet.">
      <Fragment slot="note">
        Trips go up here once dates are set. Questions in the meantime:{' '}
        <a
          href="mailto:contact@twincitiesskiclub.org"
          class="link-inline"
        >contact@twincitiesskiclub.org</a>.
      </Fragment>
    </LedgerRow>
  ) : (
    trips.map((t) => (
      <LedgerRow
        label={t.data.dates}
        labelRole="caption"
        title={t.data.slug}
        meta={t.data.location}
        href={t.data.signup_url}
      />
    ))
  )}
</Ledger>
