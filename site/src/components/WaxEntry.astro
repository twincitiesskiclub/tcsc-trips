---
// WaxEntry: editorial per-entry layout for a Wax Room field report. Body
// comes through the slot (render(entry) Content at the call site).
//
// MOUNTING CONTRACT: the article uses the site container with its content in
// the left-aligned reading column, so the photo uses CARD widths with a 720px
// sizes cap on md+ rather than full-bleed presets.
//
// GUARDS: Keystatic serializes an untouched optional object as an EMPTY MAP
// (`conditions_snapshot: {}`), so the aside only renders when at least one
// inner field is present. author_name / lede / photo are optional too.
//
// CROP STRATEGY (per CoachEntry): the photo slot is 16:9 but wax photos can
// be any shape; passing width AND a 16:9-derived height makes sharp emit
// true 16:9 renditions server-side instead of shipping the full source
// behind a CSS object-cover crop.
import { Image } from 'astro:assets';
import ProseColumn from '@/components/ProseColumn.astro';
import { CARD } from '@/components/imageWidths';
import { longDate } from '@/lib/formatDate';

interface Props {
  date: Date;
  author_name?: string;
  author_role: 'coach' | 'member' | 'board';
  title: string;
  lede?: string;
  photo?: ImageMetadata;
  photo_alt?: string;
  conditions_snapshot?: { location?: string; temp_f?: number | null; wax_used?: string };
}
const {
  date,
  author_name,
  author_role,
  title,
  lede,
  photo,
  photo_alt = '',
  conditions_snapshot,
} = Astro.props;

const formatted = longDate(date);

const photoWidth = photo ? Math.min(1200, photo.width) : 0;
const photoHeight = Math.round((photoWidth * 9) / 16);

const hasConditions =
  conditions_snapshot &&
  (conditions_snapshot.location ||
    conditions_snapshot.temp_f != null ||
    conditions_snapshot.wax_used);
---
<ProseColumn as="article">
  <Fragment slot="before">
  <div class="text-sm text-slate">{formatted}</div>
  <h1 class="type-display-inner text-navy mt-3">{title}</h1>
  {author_name && (
    <div class="mt-3 text-slate text-sm">
      By {author_name} · <span class="capitalize">{author_role}</span>
    </div>
  )}
  {hasConditions && (
    <dl class="mt-6 grid gap-6 border-y hairline py-4 sm:grid-cols-3">
      {conditions_snapshot.location && (
        <div>
          <dt class="label-caps text-mint-deep">Location</dt>
          <dd class="type-body mt-1 text-ink">{conditions_snapshot.location}</dd>
        </div>
      )}
      {conditions_snapshot.temp_f != null && (
        <div>
          <dt class="label-caps text-mint-deep">Temp</dt>
          <dd class="type-body mt-1 text-ink">{conditions_snapshot.temp_f}°F</dd>
        </div>
      )}
      {conditions_snapshot.wax_used && (
        <div>
          <dt class="label-caps text-mint-deep">Wax used</dt>
          <dd class="type-body mt-1 text-ink">{conditions_snapshot.wax_used}</dd>
        </div>
      )}
    </dl>
  )}
  {photo && (
    <div class="my-8 aspect-video overflow-hidden">
      <Image
        src={photo}
        alt={photo_alt}
        widths={CARD}
        width={photoWidth}
        height={photoHeight}
        fit="cover"
        sizes="(min-width: 768px) 720px, 100vw"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  {lede && <p class="type-lede mt-6 text-slate">{lede}</p>}
  </Fragment>
  <Fragment slot="prose">
    <div class="mt-6">
      <slot />
    </div>
  </Fragment>
</ProseColumn>
