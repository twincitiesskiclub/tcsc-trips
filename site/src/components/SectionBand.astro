---
interface Props {
  variant?: 'navy' | 'paper' | 'paper-on-navy';
  /** Section seam: the section name in the Trail Report label voice (small
      tracked caps) with a hairline running from it to the right edge, on one
      baseline. One device family across the site; physical chapter breaks
      instead of padding gaps wearing badges. */
  seam?: string;
  heading?: string;
  subhead?: string;
  rhythm?: 'sm' | 'md' | 'lg';
}
const { variant = 'paper', seam, heading, subhead, rhythm = 'md' } = Astro.props;

const rhythms = {
  sm: { y: 'band-y-sm', t: 'band-t-sm', b: 'band-b-sm' },
  md: { y: 'band-y', t: 'band-t', b: 'band-b' },
  lg: { y: 'band-y-lg', t: 'band-t-lg', b: 'band-b-lg' },
};
const band = rhythms[rhythm];

// paper-on-navy: navy band with a rounded paper card inside; the shared gutter
// keeps the card off the viewport edges below the max width.
const isCard = variant === 'paper-on-navy';
const surface = variant === 'navy' ? 'bg-navy text-paper' : isCard ? `bg-navy ${band.y}` : 'bg-paper text-ink';
const innerMax = 'max-w-site';
const padding = isCard
  ? 'rounded-xl px-8 py-12 md:px-16 md:py-20'
  : `px-6 md:px-10 ${seam ? `pt-8 ${band.b}` : band.y}`;
---
<section class={surface}>
  {seam && !isCard && (
    <div class={'gutter mx-auto ' + innerMax + ' ' + band.t}>
      <div class="flex items-center gap-4">
        <span class="seam">{seam}</span>
        <span class="rule h-px flex-1" aria-hidden="true"></span>
      </div>
    </div>
  )}
  <div class={isCard ? 'gutter' : undefined}>
    <div class={'mx-auto ' + innerMax + ' ' + (isCard ? 'bg-paper text-ink ' : '') + padding}>
      {heading && (
        <h2 class="type-h2 mb-4">{heading}</h2>
      )}
      {subhead && (
        <p class="text-lg leading-relaxed max-w-prose mb-8">{subhead}</p>
      )}
      <slot />
    </div>
  </div>
</section>
