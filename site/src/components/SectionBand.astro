---
import BandContainer from '@/components/BandContainer.astro';
import Seam from '@/components/Seam.astro';

interface Props {
  variant?: 'navy' | 'paper';
  /** Section seam: the section name in the Trail Report label voice (small
      tracked caps) with a hairline running from it to the right edge, on one
      baseline. One device family across the site; physical chapter breaks
      instead of padding gaps wearing badges. */
  seam?: string;
  heading?: string;
  rhythm?: 'sm' | 'md' | 'lg';
  flush?: 'top' | 'bottom' | 'both';
  headingRole?: 'section' | 'longform';
}
const {
  variant = 'paper',
  seam,
  heading,
  rhythm = 'md',
  flush,
  headingRole = 'section',
} = Astro.props;

const rhythms = {
  sm: { y: 'band-y-sm', t: 'band-t-sm', b: 'band-b-sm' },
  md: { y: 'band-y', t: 'band-t', b: 'band-b' },
  lg: { y: 'band-y-lg', t: 'band-t-lg', b: 'band-b-lg' },
};
const band = rhythms[rhythm];

// Navy headings stay paper. Mint is reserved for the home hero, CTA strip,
// live data, labels, links, and fills.
const surface = variant === 'navy'
  ? 'bg-navy text-paper [&_h2]:text-paper [&_h3]:text-paper'
  : 'bg-paper text-ink';
const flushTop = flush === 'top' || flush === 'both';
const flushBottom = flush === 'bottom' || flush === 'both';
const seamPadding = flushTop ? undefined : band.t;
const contentPadding = seam
  ? ['pt-8', !flushBottom && band.b].filter(Boolean).join(' ')
  : [!flushTop && band.t, !flushBottom && band.b].filter(Boolean).join(' ');
const headingClass = headingRole === 'longform' ? 'type-h2-longform' : 'type-h2';
---
<section class={surface}>
  {seam && (
    <BandContainer class={seamPadding}>
      <Seam
        label={seam}
        surface={variant === 'navy' ? 'navy' : 'paper'}
        as={heading ? 'span' : 'h2'}
      />
    </BandContainer>
  )}
  <BandContainer class={contentPadding}>
    {heading && (
      <h2 class:list={[headingClass, 'mb-4']}>{heading}</h2>
    )}
    <slot />
  </BandContainer>
</section>
