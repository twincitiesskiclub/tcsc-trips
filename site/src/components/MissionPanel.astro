---
import FactStack from '@/components/FactStack.astro';

// The home page's single moment of paper (DESIGN.md): a full-bleed band, not
// a floating card. Asymmetric 8/3 split: the mission statement at display
// scale, plus a stat stack of org facts behind a vertical hairline for the
// sponsor doing 20-second due diligence. The facts deliberately avoid
// repeating the mission text's own "501(c)(3)" line.
interface Props {
  body: string;
  rhythm?: 'sm' | 'md' | 'lg';
}
const { body, rhythm = 'md' } = Astro.props;
const rhythms = {
  sm: { y: 'band-y-sm', t: 'band-t-sm' },
  md: { y: 'band-y', t: 'band-t' },
  lg: { y: 'band-y-lg', t: 'band-t-lg' },
};
const band = rhythms[rhythm];
const facts: Array<{ value: string; label: string }> = [
  { value: '2020', label: 'Founded' },
  { value: 'Minneapolis · St. Paul', label: 'Based in' },
  { value: '80+', label: 'Skiers at the 2026 Birkie' },
];
---
<section class:list={['bg-navy', band.t]}>
  <div class="bg-paper text-ink">
    <div class:list={['gutter mx-auto max-w-site grid gap-10 md:grid-cols-12', band.y]}>
      <p class="type-statement md:col-span-8 text-navy">{body}</p>
      <FactStack
        facts={facts}
        size="lg"
        align="center"
        class="md:col-span-3 md:col-start-10"
      />
    </div>
  </div>
</section>
