---
// SponsorWall: sponsor logos grouped by tier. Tiers with no sponsors render
// nothing (no orphan headings). A sponsor without a url gets a plain <div>
// wrapper, never a dead `<a href="#">` (dynamic Wrapper tag below). Linked
// logo alt text names the website destination; unlinked logos use the sponsor's
// display name (entry.data.slug, see content.config.ts header).
//
// headingLevel keeps the document outline contiguous: the sponsors page
// mounts the wall directly under its h1, so it passes 'h2'; the default
// 'h3' suits mounts beneath an existing h2.
//
// variant 'strip' renders one compact logo row (home page band); 'wall' is the tiered /sponsors layout.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { THUMB } from '@/components/imageWidths';
import { groupSponsorsByTier } from '@/lib/sponsorTiers.js';

interface Props {
  headingLevel?: 'h2' | 'h3';
  /** 'wall' (default): tiered groups for /sponsors. 'strip': one compact
      logo row for the home page band - no tier headings, smaller logos. */
  variant?: 'wall' | 'strip';
}
const { headingLevel: Heading = 'h3', variant = 'wall' } = Astro.props;

const sponsors = await getCollection('sponsors');
const tierGroups = groupSponsorsByTier(sponsors);
---
{variant === 'strip' ? (
  <div class="flex flex-wrap items-center gap-x-14 gap-y-8">
    {tierGroups.flatMap((g) => g.items).map((s) => {
      const Wrapper = s.data.url ? 'a' : 'div';
      return (
        <Wrapper {...(s.data.url ? { href: s.data.url, rel: 'sponsored' } : {})}>
          <Image
            src={s.data.logo}
            alt={s.data.url ? `${s.data.slug} website` : s.data.slug}
            widths={THUMB}
            width={Math.min(400, s.data.logo.width)}
            sizes="200px"
            class="max-h-10 sm:max-h-12 max-w-logo-sm h-auto w-auto"
            loading="lazy"
          />
        </Wrapper>
      );
    })}
  </div>
) : (
  tierGroups.map(({ tier, label, items }) => {
    const logoClass =
      tier === 'trailblazer'
        ? 'max-h-16 sm:max-h-24 max-w-logo-mobile sm:max-w-logo-lg'
        : tier === 'community_partner'
          ? 'max-h-16 sm:max-h-20 max-w-logo-md'
          : 'max-h-16 max-w-logo-sm';

    return (
      <section class="mt-8 first:mt-0 border-y hairline py-8 md:grid md:grid-cols-12 md:gap-8 md:py-10">
        <Heading class="seam text-mint-deep md:col-span-3">
          {label}
        </Heading>
        <div class="mt-7 flex flex-wrap items-start justify-start gap-x-6 gap-y-8 sm:gap-x-10 md:col-span-9 md:mt-0">
          {items.map((s) => {
            const Wrapper = s.data.url ? 'a' : 'div';
            return (
              <Wrapper
                class="inline-flex min-h-16 items-center justify-start sm:min-h-24"
                {...(s.data.url ? { href: s.data.url, rel: 'sponsored' } : {})}
              >
                <Image
                  src={s.data.logo}
                  alt={s.data.url ? `${s.data.slug} website` : s.data.slug}
                  widths={THUMB}
                  width={Math.min(600, s.data.logo.width)}
                  sizes={
                    tier === 'trailblazer'
                      ? '(min-width: 640px) 280px, 80vw'
                      : tier === 'community_partner'
                        ? '(min-width: 640px) 240px, 75vw'
                        : '(min-width: 640px) 200px, 70vw'
                  }
                  class={`${logoClass} h-auto w-auto`}
                  loading="lazy"
                />
              </Wrapper>
            );
          })}
        </div>
      </section>
    );
  })
)}
