---
// WaxRoomFeed: home-page strip of the three newest Wax Room entries, set as
// a full-bleed PAPER band: with the mission panel it gives the home scroll
// its navy/paper rhythm (the spine fix from the UI debate; the teaser also
// shares a surface with its paper destination page, so the rhythm is
// truthful). Logbook grammar, not tiles: each entry is a dated field-log
// line (date · author / title / one line of trail truth); the form is the
// design, so every future club-written entry inherits the voice. The home
// teaser stays hidden until at least one published entry exists; the Wax
// Room index owns the empty state.
//
// entry.id = filename slug (url), entry.data.slug = display title
// (see content.config.ts header).
import { getCollection } from 'astro:content';
import Ledger from '@/components/Ledger.astro';
import WaxEntryRow from '@/components/WaxEntryRow.astro';
import BandContainer from '@/components/BandContainer.astro';
import Seam from '@/components/Seam.astro';
import SectionHeader from '@/components/SectionHeader.astro';

interface Props {
  rhythm?: 'sm' | 'md' | 'lg';
}
const { rhythm = 'md' } = Astro.props;
const rhythms = {
  sm: { t: 'band-t-sm', b: 'band-b-sm' },
  md: { t: 'band-t', b: 'band-b' },
  lg: { t: 'band-t-lg', b: 'band-b-lg' },
};
const band = rhythms[rhythm];

const entries = (await getCollection('wax_entries'))
  .sort((a, b) => +b.data.date - +a.data.date || a.id.localeCompare(b.id))
  .slice(0, 3);
---
{entries.length > 0 && (
  <section class="bg-paper text-ink">
    <BandContainer>
      <Seam surface="paper" class={band.t} />
      <div class:list={['pt-8', band.b]}>
        <SectionHeader
          more_href="/wax-room"
          more_label="All entries"
          class="mb-8"
        >
          <h2 class="type-h2-longform text-navy">From the Wax Room</h2>
        </SectionHeader>
        <Ledger cols="three" surface="paper">
          {entries.map((e) => (
            <WaxEntryRow entry={e} density="feed" />
          ))}
        </Ledger>
      </div>
    </BandContainer>
  </section>
)}
