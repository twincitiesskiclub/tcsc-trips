---
// WaxRoomFeed: the home page's closing paper chapter. Wax Room entries and
// sponsors share one surface so paper remains a deliberate moment rather
// than an alternating stripe. Logbook grammar, not tiles: each entry is a
// dated field-log line, and the sponsor row closes the chapter even when no
// entries have been published yet.
//
// entry.id = filename slug (url), entry.data.slug = display title
// (see content.config.ts header).
import { getCollection } from 'astro:content';
import Ledger from '@/components/Ledger.astro';
import WaxEntryRow from '@/components/WaxEntryRow.astro';
import BandContainer from '@/components/BandContainer.astro';
import Seam from '@/components/Seam.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import SponsorWall from '@/components/SponsorWall.astro';

interface Props {
  rhythm?: 'sm' | 'md' | 'lg';
}
const { rhythm = 'md' } = Astro.props;
const rhythms = {
  sm: { t: 'band-t-sm', b: 'band-b-sm' },
  md: { t: 'band-t', b: 'band-b' },
  lg: { t: 'band-t-lg', b: 'band-b-lg' },
};
const band = rhythms[rhythm];

const entries = (await getCollection('wax_entries'))
  .sort((a, b) => +b.data.date - +a.data.date || a.id.localeCompare(b.id))
  .slice(0, 3);
---
<section class="bg-paper text-ink">
  <BandContainer>
    <Seam
      label={entries.length > 0 ? 'Wax room' : 'Our sponsors'}
      surface="paper"
      as={entries.length > 0 ? 'span' : 'h2'}
      class={band.t}
    />
    <div class:list={['pt-8', band.b]}>
      {entries.length > 0 && (
        <div>
          <SectionHeader
            more_href="/wax-room"
            more_label="All entries"
            class="mb-8"
          >
            <h2 class="type-h2-longform text-navy">From the Wax Room</h2>
          </SectionHeader>
          <Ledger cols="three" surface="paper">
            {entries.map((e) => (
              <WaxEntryRow entry={e} density="feed" />
            ))}
          </Ledger>
        </div>
      )}

      <div class:list={[entries.length > 0 && 'mt-12 pt-12 border-t hairline-soft']}>
        {entries.length > 0 && <Seam label="Our sponsors" surface="paper" />}
        <SectionHeader
          more_href="/sponsors"
          more_label="Sponsor the club"
          class={entries.length > 0 ? 'mt-8' : undefined}
        >
          <SponsorWall variant="strip" />
        </SectionHeader>
      </div>
    </div>
  </BandContainer>
</section>
