---
import Seam from '@/components/Seam.astro';

// Live conditions strip: current temp + wax recommendation at four Twin Cities
// ski areas, fetched client-side from the Flask /api/conditions endpoint.
interface Props {
  variant?: 'prominent' | 'compact';
}
const { variant = 'prominent' } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_CONDITIONS_API_URL ?? 'https://tcsc.ski/api/conditions';
// Coupled to LOCATIONS in app/conditions/locations.py (Flask repo). Names
// are server-rendered so the strip reads as four named venues even before
// hydration or when the API is unreachable; the client overwrites them with
// the API's names on every successful fetch. The fifth cell is the Birkie
// likelihood status (payload.birkie), not a venue.
const locations = [
  { id: 'wirth', name: 'Theo' },
  { id: 'elm', name: 'Elm' },
  { id: 'hyland', name: 'Hyland' },
  { id: 'telemark', name: 'Telemark' },
];
---
<section
  class={variant === 'prominent'
    ? 'group/conditions bg-navy-deep text-paper border-y hairline-soft'
    // Compact strip: solid navy-deep (like prominent), NOT bg-navy/40: the
    // translucent navy over the paper page background landed text-paper/75
    // at 1.91:1 (axe fail); on solid navy-deep it measures 9.1:1 (AA pass).
    : 'group/conditions bg-navy-deep text-paper text-xs border-t hairline-soft'}
  data-live-conditions
  data-api-url={apiUrl}
  aria-label="Current ski conditions"
>
  <span class="sr-only" aria-live="polite" data-announcer></span>
  {variant === 'prominent' ? (
    <div data-conditions-inner class="gutter mx-auto max-w-site">
      <div data-conditions-meta class="pt-3 pb-2 flex flex-col items-stretch gap-y-2 md:flex-row md:items-center md:gap-x-4 md:gap-y-0.5">
        <Seam label="Trail report" surface="navy" as="h2" class="w-full md:min-w-0 md:flex-1" />
        <span class="type-caption text-coral text-left min-w-0 md:ml-auto md:text-right" data-updated>Loading conditions…</span>
      </div>
      <div data-conditions-grid class="pb-4 grid grid-cols-2 md:grid-cols-5 gap-y-4">
        {/* On a phone the full grid is overwhelming, so mobile leads with just
            the Theodore Wirth cell (the club's home venue); the other three
            venues and the fever cell are desktop-only. */}
        {locations.map(({ id, name }) => (
          <div
            data-location={id}
            class={id === 'wirth'
              ? 'py-1 col-span-2 md:col-span-1 md:border-r hairline-soft md:pr-5'
              : 'max-md:hidden py-1 md:border-r hairline-soft md:px-4 md:pr-5'}
          >
            <div class="label-caps" data-name>{name}</div>
            <div class="mt-1 flex items-baseline gap-2">
              <span class="font-display text-2xl md:text-3xl text-mint" data-temp>·</span>
              <span class="type-caption text-paper/75" data-feels></span>
            </div>
            {/* min-h-8 reserves two text-xs lines (line-height 1rem each) so
                the post-hydration wax label can wrap without pushing the hero
                down (CLS guard). */}
            <div class="text-xs text-paper/75 mt-1 min-h-8 flex items-start gap-1.5">
              <span
                class="wax-chip mt-1 h-2 w-2 rounded-full shrink-0 data-[band=green]:bg-wax-green data-[band=blue]:bg-wax-blue data-[band=purple]:bg-wax-purple data-[band=red]:bg-wax-red"
                data-wax-chip
                hidden
              ></span>
              <span data-wax>·</span>
            </div>
          </div>
        ))}
        {/* Fifth cell: Birkie fever. The big number reads like the venue
            temperature cells beside it, except it's your fever (the
            likelihood, on a thermometer: 98.6 in June, 104 when the trail
            skis good in the race window). The cell is also a button:
            clicking plays the club's Birkie Fever song (lazy Audio,
            nothing fetched until the click). */}
        <button
          type="button"
          data-birkie
          data-birkie-audio="/audio/birkie-fever.mp3"
          aria-pressed="false"
          aria-label="Birkie fever. Press to play the song."
          class="group py-1 text-left max-md:hidden col-span-2 pl-0 md:col-span-1"
        >
          <div class="label-caps transition-colors group-hover:text-paper">
            Birkie fever
            <span class="ml-1 text-mint/50 transition-colors group-hover:text-paper" data-fever-note aria-hidden="true">♪</span>
          </div>
          <div class="mt-1">
            <span class="font-display text-2xl md:text-3xl text-mint transition-colors group-hover:text-paper" data-birkie-word>·</span>
          </div>
          <div class="text-xs text-paper/75 mt-1 min-h-8 transition-colors group-hover:text-paper" data-birkie-detail>·</div>
        </button>
      </div>
    </div>
  ) : (
    <div class="gutter mx-auto max-w-site py-2 flex gap-x-4 gap-y-1 flex-wrap text-paper/75">
      {/* Mobile keeps just the Theodore Wirth line; the other venues and the
          fever line are desktop-only. */}
      <span
        aria-hidden="true"
        data-live-dot
        class="label-caps text-xs text-paper/75 group-data-[updated-at]/conditions:text-coral"
      >●</span>
      {locations.map(({ id, name }) => (
        <div data-location={id} class={id === 'wirth' ? 'flex items-baseline gap-1.5' : 'max-md:hidden flex items-baseline gap-1.5'}>
          <span class="label-caps" data-name>{name}</span>
          <span class="text-sm font-bold tabular-nums text-paper" data-temp>·</span>
          <span data-wax>·</span>
        </div>
      ))}
      <div data-birkie class="max-md:hidden flex items-baseline gap-1.5">
        <span class="label-caps">Birkie fever</span>
        <span class="text-sm font-bold tabular-nums text-paper" data-birkie-word>·</span>
      </div>
    </div>
  )}
</section>

<style>
  /* First-fill entrance (group fade, no stagger): cells sit at opacity 0
     only between client init and the first render, keyed on data attributes
     the client sets, so no-JS visitors always see the server-rendered names
     and every 5-minute refresh after first paint is inert by construction.
     The client also arms a timeout backstop so a slow API can't hold the
     strip invisible. Transform/opacity only; the global reduced-motion rule
     collapses the transition. */
  [data-live-conditions] [data-location],
  [data-live-conditions] [data-birkie] {
    transition:
      opacity 250ms var(--ease-out),
      transform 250ms var(--ease-out);
  }
  [data-live-conditions][data-lc-initialized='true']:not([data-filled='true']) [data-location],
  [data-live-conditions][data-lc-initialized='true']:not([data-filled='true']) [data-birkie] {
    opacity: 0;
    transform: translateY(4px);
  }
  /* Coral means the fetch succeeded. Loading, unavailable, and off-season
     copy never carries the live-state signal. */
  [data-live-conditions]:not([data-updated-at]) [data-updated] {
    color: var(--color-paper-muted);
  }
  [data-location] a[data-source-link] {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-block: -0.5rem;
  }

  /* Dryland is a dateline, not an empty five-column instrument. The client
     supplies the seasonal label and fever value; CSS only recomposes those
     existing nodes, so no-JS visitors retain the server-rendered venues. */
  @media (min-width: 48rem) {
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) {
      min-height: 2.5rem;
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) [data-conditions-meta],
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) [data-conditions-grid] {
      display: contents;
    }
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) [data-updated],
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) [data-birkie-detail] {
      display: none;
    }
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) :global([data-seam]) {
      width: auto;
      flex: none;
    }
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) :global([data-seam] .rule) {
      display: none;
    }
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) :global([data-dryland-label]) {
      display: inline-flex !important;
      align-items: baseline;
    }
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) :global([data-dryland-label])::before,
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) [data-birkie]::before {
      content: '·';
      margin-right: 0.5rem;
      color: color-mix(in oklab, currentColor 60%, transparent);
    }
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) [data-birkie] {
      display: inline-flex;
      align-items: baseline;
      gap: 0.375rem;
      padding: 0;
    }
    [data-live-conditions]:has([data-updated]) [data-conditions-inner]:has([data-dryland-label]) [data-birkie] > div {
      margin-top: 0;
    }
  }

</style>

<script>
  import { init } from '@/components/LiveConditions.client';
  init();
</script>
