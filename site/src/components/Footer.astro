---
// Footer: hardcoded contact info (contact singleton removed, F07).
// No /contact link (page deleted).
import { FOOTER_EXTRAS, getNavLinks } from '@/components/navLinks';

const email = 'contact@twincitiesskiclub.org';
const ig = 'https://www.instagram.com/twincitiesskiclub/';

interface Props {
  rhythm?: 'sm' | 'md' | 'lg';
}
const { rhythm = 'sm' } = Astro.props;
const rhythmClass = { sm: 'band-y-sm', md: 'band-y', lg: 'band-y-lg' }[rhythm];

// Two columns read top-to-bottom. Primary links stay in the same order as
// the header, with footer-only destinations appended afterward.
const footerLinks = [...await getNavLinks(), ...FOOTER_EXTRAS];
const splitAt = Math.ceil(footerLinks.length / 2);
const colA = footerLinks.slice(0, splitAt);
const colB = footerLinks.slice(splitAt);
---
<footer class="bg-navy text-paper border-t hairline-soft">
  <div class:list={['footer-inner gutter mx-auto max-w-site grid gap-10 md:grid-cols-3', rhythmClass]}>
    <div>
      <a href="/" class="inline-flex min-h-10 items-center" aria-label="Twin Cities Ski Club home">
        <svg width="120" height="18" viewBox="0 0 358.78 54.47" aria-hidden="true">
          <g fill="#9EF9BE">
            <polygon points="105.53 42.42 107.8 35.26 77.36 35.26 74.61 42.42 105.53 42.42"/>
            <path d="M22.82,35.26c-2.2,0-20.29,0-21.74,1s-1.44,4.3,0,5.26,19.54,1,21.74,1H45l2-7.16Z"/>
            <polygon points="173.35 35.26 163.99 35.26 161.65 42.42 173.35 42.42 180.19 42.47 182.49 35.2 173.35 35.26"/>
            <polygon points="237.75 35.02 235.25 42.65 255.83 42.74 258.31 34.93 237.75 35.02"/>
            <path d="M357.69,37.57c-4.46-3.44-24.53-2.9-26.73-2.9l-17,.08-2.67,8.17L331,43c2.2,0,22.27-.06,26.73-2.9C359.14,39.15,359.14,38.53,357.69,37.57Z"/>
            <polygon points="261 20.56 263.48 12.74 236.5 12.84 234.01 20.45 261 20.56"/>
            <path d="M331,20.82c2.2,0,22.27-.06,26.73-2.9,1.45-1,1.45-1.58,0-2.54-4.46-3.44-24.53-2.9-26.73-2.9l-13,.07-2.68,8.19Z"/>
            <polygon points="173.35 20.23 185.91 20.28 188.22 13.01 173.35 13.07 162.31 13.07 159.97 20.23 173.35 20.23"/>
            <path d="M22.82,13.07c-2.2,0-20.29,0-21.74.95s-1.44,4.3,0,5.26,19.54.95,21.74.95h9.1l2-7.16Z"/>
            <polygon points="88.23 13.07 85.54 20.23 110.43 20.23 112.7 13.07 88.23 13.07"/>
          </g>
          <g fill="#FBFAF8">
            <path d="M53.13,14.06H38.33V1.33H80.66V14.06H65.86V53.14H53.13Z"/>
            <path d="M130.39,32.56c0,5.7.37,9.18,5.84,9.18s6.07-2.89,6.37-8l12.28,2.73c0,4.89-1.11,18-18.65,18s-18.57-13.1-18.57-18V18c0-4.88,1-18,18.57-18s18.65,13.1,18.65,18L142.6,20.72c-.3-5.1-.89-8-6.37-8s-5.84,3.48-5.84,9.18Z"/>
            <path d="M217.26,18.65c-.59-4.52-3.18-5.77-6.81-5.77-2.88,0-4.66,1.7-4.36,3.4,1,5.77,24.79,5.63,24.79,22.65,0,2.22-2.52,15.32-20.06,15.32-15.83,0-19.31-10-19.31-16.51L204.09,35c.37,5.33,3.11,6.52,6.73,6.52s6.29-2.15,5.85-4.15c-1.41-6.29-24-4.88-24-21.9C192.54,13.25,193.88.15,210.45.15c15.54,0,19.32,9.25,19.32,15.76Z"/>
            <path d="M281.23,32.56c0,5.7.37,9.18,5.85,9.18s6.07-2.89,6.36-8l12.29,2.73c0,4.89-1.11,18-18.65,18s-18.58-13.1-18.58-18V18c0-4.88,1-18,18.58-18s18.65,13.1,18.65,18l-12.29,2.74c-.29-5.1-.89-8-6.36-8s-5.85,3.48-5.85,9.18Z"/>
          </g>
        </svg>
      </a>
      <p class="type-body mt-3 max-w-prose-narrow text-paper/75">
        A 501(c)(3) nonprofit for cross-country skiers ages 21-35 in Minneapolis · St. Paul. Coached practices twice a week, two seasons a year.
      </p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 content-start gap-x-6 gap-y-0 text-sm">
      <div>
        {colA.map((l) => <a class="link-nav flex min-h-10 items-center" href={l.href}>{l.label}</a>)}
      </div>
      <div>
        {colB.map((l) => <a class="link-nav flex min-h-10 items-center" href={l.href}>{l.label}</a>)}
      </div>
    </nav>
    <div class="text-sm text-paper/75">
      <a class="link-nav flex min-h-10 items-center" href={'mailto:' + email}>{email}</a>
      <a class="link-nav flex min-h-10 items-center" href={ig}>Instagram</a>
      <p class="type-caption pt-3 text-paper/75">All photos by club members.</p>
      <p class="type-caption mt-2 text-paper/75">© {new Date().getFullYear()} Twin Cities Ski Club</p>
    </div>
  </div>
</footer>

<style>
  .footer-inner {
    padding-bottom: calc(var(--band-space, 3rem) + env(safe-area-inset-bottom, 0px));
  }
</style>
