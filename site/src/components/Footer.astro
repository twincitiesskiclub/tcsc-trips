---
// Footer: hardcoded contact info (contact singleton removed, F07).
// No /contact link (page deleted).
import { FOOTER_EXTRAS, getNavLinks } from '@/components/navLinks';

const email = 'contact@twincitiesskiclub.org';
const ig = 'https://www.instagram.com/twincitiesskiclub/';

interface Props {
  rhythm?: 'sm' | 'md' | 'lg';
}
const { rhythm = 'sm' } = Astro.props;
const rhythmClass = { sm: 'band-y-sm', md: 'band-y', lg: 'band-y-lg' }[rhythm];

// Two columns read top-to-bottom. Primary links stay in the same order as
// the header, with footer-only destinations appended afterward.
const footerLinks = [...await getNavLinks(), ...FOOTER_EXTRAS];
const splitAt = Math.ceil(footerLinks.length / 2);
const colA = footerLinks.slice(0, splitAt);
const colB = footerLinks.slice(splitAt);
---
<footer class="bg-navy text-paper border-t hairline-soft">
  <div class:list={['footer-inner gutter mx-auto max-w-site grid gap-10 md:grid-cols-3', rhythmClass]}>
    <div>
      <div class="text-sm font-bold text-mint">Twin Cities Ski Club</div>
      <p class="type-body mt-3 text-paper/75 max-w-prose-narrow">
        A 501(c)(3) nonprofit for cross-country skiers ages 21-35 in Minneapolis · St. Paul. Coached practices twice a week, two seasons a year.
      </p>
    </div>
    <nav aria-label="Footer" class="text-sm grid grid-cols-2 gap-x-6 content-start">
      <div class="md:space-y-2">
        {colA.map((l) => <a class="link-nav flex min-h-11 items-center md:min-h-0 md:block" href={l.href}>{l.label}</a>)}
      </div>
      <div class="md:space-y-2">
        {colB.map((l) => <a class="link-nav flex min-h-11 items-center md:min-h-0 md:block" href={l.href}>{l.label}</a>)}
      </div>
    </nav>
    <div class="text-sm space-y-2">
      <a class="link-nav flex min-h-11 items-center md:min-h-0 md:block" href={'mailto:' + email}>{email}</a>
      <a class="link-nav flex min-h-11 items-center md:min-h-0 md:block" href={ig}>Instagram</a>
      <p class="text-paper/75 pt-3">All photos by club members.</p>
      <p class="text-paper/75">© {new Date().getFullYear()} Twin Cities Ski Club</p>
    </div>
  </div>
</footer>

<style>
  .footer-inner {
    padding-bottom: calc(var(--band-space, 3rem) + env(safe-area-inset-bottom, 0px));
  }
</style>
