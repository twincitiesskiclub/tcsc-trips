---
// /trips: index of upcoming trips. TripsTable handles its own empty state.
import InnerPageLayout from '@/layouts/InnerPageLayout.astro';
import TripsTable from '@/components/TripsTable.astro';
---
<InnerPageLayout
  title="Trips · Twin Cities Ski Club"
  description="Club trips to regional race weekends and training camps, with lodging and rides organized by TCSC."
  headline="Trips"
  subhead="Race weekends and training trips, with lodging and rides organized by the club."
>
  <div class="safe-inline-6 mx-auto max-w-4xl px-6 py-12">
    <TripsTable />
  </div>
</InnerPageLayout>
