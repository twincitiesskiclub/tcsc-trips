---
// /dry-tri: the club's own public race. Roll/Ride/Run triptych under the
// masthead (the three legs as one strip, hairline gaps like the mosaic),
// then the 2025 course format as a ledger, then the year-one recap and the
// 2026 status from the markdoc body, then the two outbound links.
import { getEntry, render } from 'astro:content';
import InnerPageLayout from '@/layouts/InnerPageLayout.astro';
import ProseColumn from '@/components/ProseColumn.astro';
import PhotoStrip from '@/components/PhotoStrip.astro';
import SectionBand from '@/components/SectionBand.astro';
import Ledger from '@/components/Ledger.astro';
import LedgerRow from '@/components/LedgerRow.astro';
import { metaDescription } from '@/lib/metaDescription';

const page = await getEntry('dry_tri', 'dry_tri');
if (!page) throw new Error('dry_tri singleton missing (src/content/pages/dry_tri.mdoc)');
const { Content } = await render(page);
const d = page.data;
const legs = [
  { src: d.roll_photo, alt: d.roll_photo_alt ?? '', loading: 'eager' as const },
  { src: d.ride_photo, alt: d.ride_photo_alt ?? '', loading: 'eager' as const },
  { src: d.run_photo, alt: d.run_photo_alt ?? '', loading: 'eager' as const },
].filter((leg): leg is { src: ImageMetadata; alt: string; loading: 'eager' } => Boolean(leg.src));
---
<InnerPageLayout
  title="Dry Tri · Twin Cities Ski Club"
  description={d.intro && metaDescription(d.intro)}
  headline={d.headline ?? 'The Dry Tri'}
  subhead={d.intro}
  facts={[
    { value: 'Roll · Ride · Run', label: 'Format' },
    { value: 'Carver Park Reserve', label: 'Venue' },
    { value: 'October 2025', label: 'First held' },
  ]}
>
  {legs.length === 3 && (
    <section class="gutter mx-auto max-w-site band-t-sm" aria-label="The three legs">
      <PhotoStrip photos={legs} cols={3} aspect="4/5" />
    </section>
  )}
  {d.courses.length > 0 && (
    <SectionBand variant="paper" seam="The course">
      <Ledger cols="three" surface="paper">
        {d.courses.map((c) => (
          <LedgerRow label={c.name} note={c.legs} meta={c.start} />
        ))}
      </Ledger>
      <p class="mt-4 text-sm text-slate">The 2025 format. Each leg starts and ends at the transition zone in the Parley Lake lot.</p>
    </SectionBand>
  )}
  <ProseColumn flush="top">
    <Fragment slot="prose">
      <Content />
    </Fragment>
    <div class="mt-8 flex flex-wrap gap-x-8 gap-y-2 text-sm">
      {d.register_url && (
        <a
          href={d.register_url}
          class="link-inline"
        >Registration and updates</a>
      )}
      {d.results_url && (
        <a
          href={d.results_url}
          class="link-inline"
        >2025 results</a>
      )}
    </div>
  </ProseColumn>
</InnerPageLayout>
