---
// /wax-room: index of all Wax Room entries, newest first.
// entry.id = filename slug (url), entry.data.slug = display title.
import { getCollection } from 'astro:content';
import InnerPageLayout from '@/layouts/InnerPageLayout.astro';
import ProseColumn from '@/components/ProseColumn.astro';
import Ledger from '@/components/Ledger.astro';
import WaxEntryRow from '@/components/WaxEntryRow.astro';

const entries = (await getCollection('wax_entries')).sort(
  (a, b) => +b.data.date - +a.data.date || a.id.localeCompare(b.id),
);
---
<InnerPageLayout
  title="The Wax Room · Twin Cities Ski Club"
  description="Conditions, wax notes, race-day prep, and technique. Field reports from TCSC coaches and members."
  headline="The Wax Room"
  subhead="Conditions, wax notes, race-day prep, and technique. Field reports from TCSC coaches and members."
>
  <ProseColumn>
    {entries.length === 0 ? (
      <p class="reading-column text-slate">No entries yet. The first reports arrive with the snow.</p>
    ) : (
      <Ledger cols="three" rule="top" surface="paper">
        {entries.map((e) => (
          <WaxEntryRow entry={e} density="index" />
        ))}
      </Ledger>
    )}
  </ProseColumn>
</InnerPageLayout>
