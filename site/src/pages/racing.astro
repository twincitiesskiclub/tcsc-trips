---
// /racing: racing story from the `racing` singleton plus the structured
// races list (date / name / location rows, optional full-width notes) and a
// member-shot race photo strip. Strip photos are direct imports, not
// photos-collection entries (entries would also join the community mosaic).
import { getEntry, render } from 'astro:content';
import InnerPageLayout from '@/layouts/InnerPageLayout.astro';
import ProseColumn from '@/components/ProseColumn.astro';
import PhotoStrip from '@/components/PhotoStrip.astro';
import Ledger from '@/components/Ledger.astro';
import LedgerRow from '@/components/LedgerRow.astro';
import { metaDescription } from '@/lib/metaDescription';
// CONSENT.md:87
import raceCrewFrosty from '@/assets/images/photos/race-crew-frosty.jpg';
// CONSENT.md:88
import skiDeSheTrio from '@/assets/images/photos/ski-de-she-trio.jpg';
// CONSENT.md:89
import korteMedals from '@/assets/images/photos/korte-medals.jpg';
// CONSENT.md:90
import birkieStart from '@/assets/images/photos/birkie-start.jpg';
// CONSENT.md:91
import finlandiaPodium from '@/assets/images/photos/finlandia-podium.jpg';
// CONSENT.md:92
import skijorRace from '@/assets/images/photos/skijor-race.jpg';

const racing = await getEntry('racing', 'racing');
if (!racing) throw new Error('racing singleton missing (src/content/pages/racing.mdoc)');
const { Content } = await render(racing);
const races = racing.data.races;

const raceStrip = [
  { src: skiDeSheTrio, alt: 'Three members in TCSC jerseys and race bibs in front of the Ski de She sponsor wall', position: 'center 30%' },
  { src: korteMedals, alt: 'Two finishers with Kortelopet medals and bibs grinning in bright winter sun', position: 'center 30%' },
  { src: birkieStart, alt: 'Two members in matching TCSC kits with arms raised at the Birkie start area', position: 'center 30%' },
  { src: finlandiaPodium, alt: 'Three skiers holding trophy axes in front of the Minnesota Finlandia Ski Marathon banner', position: 'center 30%' },
  { src: skijorRace, alt: 'A member skijoring with their dog mid-race, bib 9527, in a TCSC suit on a snowy course', position: '82% center' },
];
---
<InnerPageLayout
  title="Racing · Twin Cities Ski Club"
  description={racing.data.intro && metaDescription(racing.data.intro)}
  headline={racing.data.headline ?? 'Twin Cities Ski Club racers'}
  subhead={racing.data.intro}
  facts={[
    { value: '80+', label: 'Skiers at the 2026 Birkie' },
  ]}
  photo={raceCrewFrosty}
  photoAlt="Six members in race bibs, arms around each other, in frosty woods before a start"
  photoPosition="center 30%"
>
  <ProseColumn>
    <Fragment slot="prose">
      <Content />
    </Fragment>
    {races.length > 0 && (
      <section class="mt-12">
      <h2 class="type-h2-longform text-navy">Races</h2>
      <Ledger cols="three" rule="top" surface="paper" class="mt-6">
        {races.map((r) => (
          <LedgerRow
            label={r.date}
            labelRole="caption"
            title={r.name}
            meta={r.location}
            note={r.notes}
            href={r.href}
          />
        ))}
      </Ledger>
      </section>
    )}
  </ProseColumn>
  {races.length > 0 && (
    <section class="gutter mx-auto max-w-site band-b-sm" aria-label="Race photos">
      <PhotoStrip photos={raceStrip} cols={5} aspect="3/4" mobileLead />
    </section>
  )}
</InnerPageLayout>
